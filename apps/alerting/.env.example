KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=iotflow.telemetry
KAFKA_GROUP_ID=iotflow-alerting

# Optional: JSON file with an array of alert rules (defaults are built in)
# ALERT_RULES_PATH=./rules.json
# Optional: POST alerts to this URL
# ALERT_WEBHOOK_URL=http://localhost:8080/alerts

ALERT_COOLDOWN_MS=60000
ALERT_LATENCY_BUDGET_MS=1000
