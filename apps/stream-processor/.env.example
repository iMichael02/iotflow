KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=iotflow.telemetry
KAFKA_GROUP_ID=iotflow-stream-processor

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_SILVER_BUCKET=silver

# Flush a Parquet batch after this many records or this many milliseconds
SILVER_BATCH_SIZE=500
SILVER_FLUSH_INTERVAL_MS=10000
